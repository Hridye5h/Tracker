# Copy this file to config/config.env and fill in real values.
# config/config.env is gitignored so your secrets are never committed.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (a replica set — required for transactions).
# Example: mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/expense_tracker
MONGO_URI=your_mongodb_atlas_connection_string_here

# Secret used to sign JWTs. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=30d
